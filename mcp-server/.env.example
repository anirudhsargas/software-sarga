# ─────────────────────────────────────────────
# Sarga Prints MCP Server — Environment Config
# Copy to .env and fill in real values
# ─────────────────────────────────────────────

# Transport mode: stdio (for Claude Desktop) or http (for remote access)
MCP_TRANSPORT=stdio

# ─── Database (Aiven MySQL) ───
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_password_here
DB_NAME=sarga_staging
DB_SSL=true

# ─── Authentication (same secrets as main backend) ───
JWT_SECRET=your_256_bit_random_secret_at_least_32_characters_long
JWT_SECRET_PREVIOUS=optional_previous_secret_for_rotation

# ─── HTTP Transport (only needed when MCP_TRANSPORT=http) ───
HTTP_PORT=3100
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── Logging ───
LOG_LEVEL=info
# Set to 'file' to also write logs to mcp-server.log
LOG_OUTPUT=console

# ─── Query Cache ───
CACHE_TTL_SECONDS=300

# ─── Rate Limiting (HTTP mode only) ───
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
