# Test Database Configuration
# Copy this to .env.test and fill in your test DB credentials.
# NEVER use production credentials here.

TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=test_user
TEST_DB_PASSWORD=test_password
TEST_DB_NAME=sarga_test

# JWT secrets (use unique test values)
JWT_SECRET=test-jwt-secret-key-that-is-at-least-32-chars-long-for-testing
JWT_SECRET_PREVIOUS=test-previous-secret-key-also-over-32-chars-for-testing
