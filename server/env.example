PORT=5000
JWT_SECRET=your_256_bit_random_secret_at_least_32_characters_long_12345678
DB_HOST=localhost
DB_USER=sarga_app
DB_PASSWORD=your_secure_database_password_here
DB_NAME=sarga_db
NODE_ENV=development

# Email Configuration (Daily Report Auto-Mailing)
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@gmail.com
EMAIL_PASS=your_app_password_here

# Gmail Configuration (Bill Email Parser)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# Per-branch email addresses (key = branch name uppercase, spaces replaced by _)
# Example: BRANCH_EMAIL_PERAMBRA=branch_email@gmail.com
# BRANCH_EMAIL_MEPPAYUR=another_branch@gmail.com

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Configuration (Comma-separated allowed origins)
# Development: http://localhost:5173,http://localhost:3000,http://localhost:5174
# Production: https://your-domain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5174

# PostgreSQL (optional - used if you want Postgres instead of MySQL)
# If both MySQL and Postgres vars are present, code should prefer the explicit PG_* vars.
PG_HOST=localhost
PG_PORT=5432
PG_USER=sarga_app
PG_PASSWORD=your_postgres_password_here
PG_DATABASE=sarga_db
# Max pooled clients
PG_MAX_CLIENTS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=2000

# Google Sheets Backup & Reporting Configuration
# GOOGLE_SERVICE_ACCOUNT: Service account JSON key string (raw JSON or base64 encoded)
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# GOOGLE_SHEET_ID: The ID of your target Google Spreadsheet (from the spreadsheet URL)
GOOGLE_SHEET_ID=your_google_sheet_id_here
