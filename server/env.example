PORT=5000
JWT_SECRET=your_256_bit_random_secret_at_least_32_characters_long_12345678
DB_HOST=localhost
DB_USER=sarga_app
DB_PASSWORD=your_secure_database_password_here
DB_NAME=sarga_db
NODE_ENV=development

# Email Configuration (Daily Report Auto-Mailing)
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@gmail.com
EMAIL_PASS=your_app_password_here

# Per-branch email addresses (key = branch name uppercase, spaces replaced by _)
# Example: BRANCH_EMAIL_PERAMBRA=branch_email@gmail.com
# BRANCH_EMAIL_MEPPAYUR=another_branch@gmail.com

# Smart Bill Upload AI Extraction
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash-lite,gemini-1.5-flash-latest,gemini-1.5-flash

# CORS Configuration (Comma-separated allowed origins)
# Development: http://localhost:5173,http://localhost:3000,http://localhost:5174
# Production: https://your-domain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5174
