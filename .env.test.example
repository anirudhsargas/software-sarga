# ═══════════════════════════════════════════════════════════════
# Sarga Prints MIS — Test Environment Variables (Template)
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.test and fill in your test DB values.
# NEVER use production credentials here.

# ── Backend Test DB (use a separate test database) ──
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=your_test_password
TEST_DB_NAME=sarga_test
TEST_DB_SSL=false

# ── JWT Secret for test tokens ──
JWT_SECRET=test-jwt-secret-at-least-32-chars-long-for-validation
JWT_SECRET_PREVIOUS=

# ── Test-specific flags ──
SKIP_ML_TESTS=true
NODE_ENV=test

# ── ML Service (for integration tests that need it) ──
ML_SERVICE_URL=http://127.0.0.1:5001

# ── Frontend E2E (Playwright) ──
E2E_BASE_URL=http://localhost:5173
