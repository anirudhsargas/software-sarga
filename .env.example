# Sample environment variables for local development
# Copy this file to `.env` and fill values before running services.

# -----------------
# Server (backend)
# -----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sarga_user
DB_PASS=your_db_password
DB_NAME=sarga_db

# JWT secret used by server (keep this safe in production)
JWT_SECRET=change_this_to_a_long_random_string

# SMTP (optional) - used for email OTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Node environment
NODE_ENV=development

# -----------------
# Redis
# -----------------
# Use REDIS_URL for managed providers (Render, Upstash, Redis Cloud)
# REDIS_URL=redis://:password@host:port
#
# Or use individual vars for self-hosted Redis:
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=true

# -----------------
# NGINX
# -----------------
NGINX_PORT=80

# -----------------
# Website / Vite (frontend)
# Prefix Vite vars with VITE_
# -----------------
# API base (without trailing /api)
VITE_API_URL=http://localhost:5000

# Google OAuth Client ID (for Google Identity Services)
# Example: 1234567890-abcdefghijkl.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
